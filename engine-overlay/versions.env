# engine-overlay/versions.env — 构建 pin（供 scripts/*.sh source；provenance 来源）
#
# 纪律（D20/PLAN §6.5）：refs/ 只读；一切我们的改动进 engine-overlay/（入库），
# 构建工作区进 build/（已 gitignore）。

# --- 引擎源码 pin（必须与 PyPI wheel 版本一致，避免 pybinding ABI 不匹配）---
# PyPI gitcg 0.21.0 的 libgitcg.so 由 tag v0.21.0 构建；refs/ HEAD 比该 tag 新 11 天，
# 因此物化时按 tag 精确取源，而不是用 refs 的工作树。
ENGINE_URL="https://github.com/piovium/genius-invokation.git"
ENGINE_TAG="v0.21.0"
ENGINE_COMMIT="c94826b4611a19f0057d667f7db3b0f9aaf68c7e"
ENGINE_PYBINDING_VERSION="0.21.0"

# --- V8 构建方式（由 tag 的 packages/cbinding/CMakeLists.txt 固定）---
# 注意：tag v0.21.0 用的是 piovium/v8-cmake（bnoordhuis/v8-cmake 的 fork，
# **把 V8 源码 vendor 进仓库**，纯 CMake+Ninja 直接编译），**不是** HEAD 的
# v8-cmake-barbara（FetchContent+depot_tools+gclient）。
# 已用 wheel 内 .so 的字符串核实：wheel 嵌的是 V8 11.6.189.4，正与本 wrapper 的
# v8/include/v8-version.h 一致。
# 该 wrapper 由 cbinding/CMakeLists.txt 的 FetchContent 声明；FetchContent 默认会做
# 非浅克隆（全历史），本机 GitHub 吞吐会卡住，故我们**预取**到 build/v8-cmake-src，
# 并用 -DFETCHCONTENT_SOURCE_DIR_V8-CMAKE 指向它（见 materialize-v8.sh）。
V8CMAKE_REPO="https://github.com/piovium/v8-cmake.git"
V8CMAKE_COMMIT="14d0f7274bb5db2aaf2e312ed0f4bee8418b9b1b"
V8_VERSION="11.6.189.4"

# --- 构建镜像 / 工具链（D20：ubuntu:22.04 与上游 CI 同 glibc 口径）---
BASE_IMAGE="ubuntu:22.04"
IMAGE_TAG="${IMAGE_TAG:-gitcg-engine-builder:22.04}"
NODE_MAJOR="24"
PNPM_VERSION="12.8.1"
CMAKE_PIP_SPEC="cmake>=3.25,<4"
# 并行度（V8 是单棵 CMake 树，直接用 cmake --build -j）。
BUILD_JOBS="${BUILD_JOBS:-8}"
