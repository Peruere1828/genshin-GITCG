#BSUB -J gitcg-collect
#BSUB -q 7702ib
#BSUB -n 64
#BSUB -R "span[hosts=1]"
#BSUB -W 24:00
#BSUB -o logs/gitcg-collect.%J.out
#BSUB -e logs/gitcg-collect.%J.err
# CPU data plane: resumable replay collection for M3. The same command resumes.
# Submit from the repo root:
#   GITCG_SEED_COUNT=500 GITCG_TAG=coldstart bsub < scripts/cluster/lsf/collect.lsf

REPO="${GITCG_REPO:-$HOME/genshin-GITCG}"
mkdir -p "$REPO/logs" data/replays
# shellcheck disable=SC1091
source "$REPO/scripts/cluster/env.sh"

export OMP_NUM_THREADS=1

OPP_ARG=(--all-opponents)
if [ -n "${GITCG_OPPONENTS:-}" ]; then
  # shellcheck disable=SC2206
  OPP_ARG=(--opponents ${GITCG_OPPONENTS})
fi

python -m train.collect \
  --deck "${GITCG_DECK:-superconduct_aggro}" \
  "${OPP_ARG[@]}" \
  --seed-start "${GITCG_SEED_START:-0}" \
  --seed-count "${GITCG_SEED_COUNT:-200}" \
  --workers "${GITCG_WORKERS:-$LSB_DJOB_NUMPROC}" \
  --tag "${GITCG_TAG:-collect}"
