#BSUB -J gitcg-train-gpu
#BSUB -q 945090ib
#BSUB -gpu "num=1"
#BSUB -W 12:00
#BSUB -o logs/gitcg-train-gpu.%J.out
#BSUB -e logs/gitcg-train-gpu.%J.err
# GPU training leg (PLAN.md §5/§5.1): train the CVPN from CPU-collected replays.
# GPU only trains/infers; rollout/search stays on the CPU queue (D7).
#   GITCG_REPLAYS="data/replays/coldstart" bsub < scripts/cluster/lsf/train_gpu.lsf

REPO="${GITCG_REPO:-$HOME/genshin-GITCG}"
mkdir -p "$REPO/logs" data/checkpoints reports/train
# shellcheck disable=SC1091
source "$REPO/scripts/cluster/env.sh"

REPLAYS="${GITCG_REPLAYS:-data/replays/collect}"

# shellcheck disable=SC2086
python -m train.pipeline \
  --replays $REPLAYS \
  --epochs "${GITCG_EPOCHS:-30}" \
  --eval-seeds "${GITCG_EVAL_SEEDS:-3}" \
  --tag "${GITCG_TAG:-cluster_gpu}"
