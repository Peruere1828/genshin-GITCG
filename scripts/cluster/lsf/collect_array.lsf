#BSUB -J gitcg-collect[1-8]
#BSUB -q 7702ib
#BSUB -n 16
#BSUB -R "span[hosts=1]"
#BSUB -W 06:00
#BSUB -o logs/gitcg-collect-%J-%I.out
#BSUB -e logs/gitcg-collect-%J-%I.err
# 海量作业模式 (PLAN.md §5): N short array elements, each a seed window, each its own
# append-only replay dir (avoids concurrent writers). Re-submit to resume.
#   GITCG_WINDOW=50 GITCG_TAG=coldstart bsub < scripts/cluster/lsf/collect_array.lsf
#   python -m train.pipeline --replays data/replays/coldstart-1 ... -8   # train on shards

REPO="${GITCG_REPO:-$HOME/genshin-GITCG}"
mkdir -p "$REPO/logs" data/replays
# shellcheck disable=SC1091
source "$REPO/scripts/cluster/env.sh"

export OMP_NUM_THREADS=1

IDX="${LSB_JOBINDEX:-1}"
WINDOW="${GITCG_WINDOW:-50}"
BASE="${GITCG_SEED_BASE:-0}"
START=$(( BASE + (IDX - 1) * WINDOW ))
TAG="${GITCG_TAG:-collect}-${IDX}"

OPP_ARG=(--all-opponents)
if [ -n "${GITCG_OPPONENTS:-}" ]; then
  # shellcheck disable=SC2206
  OPP_ARG=(--opponents ${GITCG_OPPONENTS})
fi

python -m train.collect \
  --deck "${GITCG_DECK:-superconduct_aggro}" \
  "${OPP_ARG[@]}" \
  --seed-start "$START" \
  --seed-count "$WINDOW" \
  --workers "${GITCG_WORKERS:-$LSB_DJOB_NUMPROC}" \
  --tag "$TAG"
