#BSUB -J gitcg-bench
#BSUB -q cpu1
#BSUB -n 1
#BSUB -W 00:30
#BSUB -o logs/gitcg-bench.%J.out
#BSUB -e logs/gitcg-bench.%J.err
# Single-core throughput baseline (L0). Submit from the repo root:
#   bsub < scripts/cluster/lsf/benchmark.lsf

REPO="${GITCG_REPO:-$HOME/genshin-GITCG}"
mkdir -p "$REPO/logs"
# shellcheck disable=SC1091
source "$REPO/scripts/cluster/env.sh"

python -m envs.benchmark --games "${GITCG_BENCH_GAMES:-24}" --workers 1
