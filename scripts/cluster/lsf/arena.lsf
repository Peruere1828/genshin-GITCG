#BSUB -J gitcg-arena
#BSUB -q 7702ib
#BSUB -n 64
#BSUB -R "span[hosts=1]"
#BSUB -W 08:00
#BSUB -o logs/gitcg-arena.%J.out
#BSUB -e logs/gitcg-arena.%J.err
# Scripted-opponent arena (all 20) or a checkpoint eval. Submit from repo root:
#   GITCG_SEEDS=50 bsub < scripts/cluster/lsf/arena.lsf
#   GITCG_CONTESTANTS="superconduct_aggro" GITCG_POLICY0="neural:data/checkpoints/x.pt" \
#       bsub < scripts/cluster/lsf/arena.lsf

REPO="${GITCG_REPO:-$HOME/genshin-GITCG}"
mkdir -p "$REPO/logs"
# shellcheck disable=SC1091
source "$REPO/scripts/cluster/env.sh"

export OMP_NUM_THREADS=1
ARGS=(--seeds "${GITCG_SEEDS:-50}" --seed-start "${GITCG_TEST_START:-0}"
      --workers "${GITCG_WORKERS:-$LSB_DJOB_NUMPROC}" --tag "${GITCG_TAG:-scripted_${GITCG_TEST_START:-0}}")
[ -n "${GITCG_CONTESTANTS:-}" ] && ARGS+=(--contestants ${GITCG_CONTESTANTS})
[ -n "${GITCG_POLICY0:-}" ] && ARGS+=(--policy0 "${GITCG_POLICY0}")
[ -n "${GITCG_POLICY1:-}" ] && ARGS+=(--policy1 "${GITCG_POLICY1}")

python -m eval.arena "${ARGS[@]}"
