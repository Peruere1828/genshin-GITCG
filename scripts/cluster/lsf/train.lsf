#BSUB -J gitcg-train
#BSUB -q cpu1
#BSUB -n 8
#BSUB -W 04:00
#BSUB -o logs/gitcg-train.%J.out
#BSUB -e logs/gitcg-train.%J.err
# Toy/small SoG round (collect -> train -> eval -> gate) on CPU.
#   bsub < scripts/cluster/lsf/train.lsf

REPO="${GITCG_REPO:-$HOME/genshin-GITCG}"
mkdir -p "$REPO/logs" data/checkpoints reports/train
# shellcheck disable=SC1091
source "$REPO/scripts/cluster/env.sh"

python -m train.pipeline \
  --train-seeds "${GITCG_TRAIN_SEEDS:-8}" \
  --eval-seeds "${GITCG_EVAL_SEEDS:-3}" \
  --epochs "${GITCG_EPOCHS:-30}" \
  --tag "${GITCG_TAG:-cluster_cpu}"
